# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# typescript incremental build cache — machine-local, must not be committed
# (a stale committed cache once masked a type error and broke a prod build)
*.tsbuildinfo

# vercel
.vercel

.vscode

.env
.env*
